---
/**
 * Imagem de ambiência (decorativa, sem texto alternativo), a partir do arquivo
 * mestre em public/imagens/paginas/. Gera AVIF/WebP/JPEG em várias larguras.
 *
 * - variante "abertura": 4:5 ao lado do título em telas largas; no celular,
 *   faixa baixa 16:9 recortada do centro (direção de arte com <picture>).
 * - variante "capa": 3:2 na largura do texto (artigos).
 * - variante "detalhe": 3:2 pequena (ex.: página 404).
 * O PNG mestre não vai para a saída pública.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const mestres = import.meta.glob<{ default: ImageMetadata }>('../../public/imagens/paginas/*.{png,jpg,jpeg,webp}', { eager: true });

interface Props {
  arquivo: string;
  variante: 'abertura' | 'capa' | 'detalhe';
  prioridade?: boolean;
  /** Ponto de recorte (sharp): center, top, bottom, left, right ou attention. */
  posicao?: 'center' | 'top' | 'bottom' | 'left' | 'right' | 'attention' | 'entropy';
  classe?: string;
}
const { arquivo, variante, prioridade = false, posicao = 'center', classe } = Astro.props;
const nome = arquivo.split('/').pop();
const mestre = Object.entries(mestres).find(([k]) => k.endsWith(`/${nome}`))?.[1].default;
if (!mestre) throw new Error(`Imagem não encontrada em public/imagens/paginas/: ${arquivo}`);

type Fonte = { media?: string; type: string; srcset: string; sizes: string };
const formatos = [['avif', 'image/avif'], ['webp', 'image/webp']] as const;

async function conjunto(larguras: number[], proporcao: number, formato: 'avif' | 'webp' | 'jpg') {
  const itens = await Promise.all(larguras.filter((l) => l <= mestre!.width).map(async (w) => {
    const h = Math.round(w / proporcao);
    const img = await getImage({ src: mestre!, width: w, height: h, fit: 'cover', position: posicao, format: formato, quality: formato === 'avif' ? 60 : 76 });
    return { src: img.src, w };
  }));
  return itens;
}
const srcset = (itens: { src: string; w: number }[]) => itens.map((i) => `${i.src} ${i.w}w`).join(', ');

const fontes: Fonte[] = [];
let fallback: { src: string; srcset: string; sizes: string; width: number; height: number };

if (variante === 'abertura') {
  const largo = { media: '(min-width: 900px)', larguras: [400, 600, 800], proporcao: 4 / 5, sizes: '380px' };
  const movel = { larguras: [480, 720, 960, 1200], proporcao: 16 / 9, sizes: 'calc(100vw - 40px)' };
  for (const [f, type] of formatos) {
    fontes.push({ media: largo.media, type, srcset: srcset(await conjunto(largo.larguras, largo.proporcao, f)), sizes: largo.sizes });
    fontes.push({ type, srcset: srcset(await conjunto(movel.larguras, movel.proporcao, f)), sizes: movel.sizes });
  }
  const jpgLargo = await conjunto(largo.larguras, largo.proporcao, 'jpg');
  fontes.push({ media: largo.media, type: 'image/jpeg', srcset: srcset(jpgLargo), sizes: largo.sizes });
  const jpgMovel = await conjunto(movel.larguras, movel.proporcao, 'jpg');
  fallback = { src: jpgMovel[1].src, srcset: srcset(jpgMovel), sizes: movel.sizes, width: 720, height: 405 };
} else {
  const larguras = variante === 'capa' ? [480, 720, 960, 1440] : [360, 480, 720, 960];
  const sizes = variante === 'capa' ? '(min-width: 800px) 720px, calc(100vw - 40px)' : '(min-width: 560px) 480px, calc(100vw - 40px)';
  for (const [f, type] of formatos) fontes.push({ type, srcset: srcset(await conjunto(larguras, 3 / 2, f)), sizes });
  const jpg = await conjunto(larguras, 3 / 2, 'jpg');
  fallback = { src: jpg[1].src, srcset: srcset(jpg), sizes, width: 720, height: 480 };
}
---
<figure class:list={['ambiente', `ambiente--${variante}`, classe]} aria-hidden="true">
  <picture>
    {fontes.map((f) => <source media={f.media} type={f.type} srcset={f.srcset} sizes={f.sizes} />)}
    <img
      src={fallback.src}
      srcset={fallback.srcset}
      sizes={fallback.sizes}
      width={fallback.width}
      height={fallback.height}
      alt=""
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : 'auto'}
      decoding="async"
    />
  </picture>
</figure>

<style>
  .ambiente { margin: 0; overflow: hidden; border-radius: var(--ph-raio-bloco); background: var(--ph-pedra); }
  .ambiente img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ambiente--abertura { aspect-ratio: 16 / 9; }
  @media (min-width: 900px) { .ambiente--abertura { aspect-ratio: 4 / 5; } }
  .ambiente--capa, .ambiente--detalhe { aspect-ratio: 3 / 2; }
  .ambiente--detalhe { max-width: 480px; }
</style>
