# Copie para .env e ajuste. Nada aqui é segredo: todas as variáveis são públicas.
# Os valores abaixo são exemplos não operacionais.

# Origem publicada, sem a subpasta do repositório.
#   GitHub Pages de projeto: https://USUARIO.github.io
#   Domínio definitivo:      https://psicologohomem.com.br
PUBLIC_SITE_URL=http://localhost:4321

# "/" ou "/NOME-DO-REPOSITORIO/" no GitHub Pages de projeto.
PUBLIC_BASE_PATH=/

# local | github-pages | dominio
PUBLIC_DEPLOY_TARGET=local

# false durante a prévia (gera noindex). true só no lançamento público.
# Com true, o build falha se restar algum "Informação pendente".
PUBLIC_INDEXABLE=false

# ID real do fluxo web do GA4, no formato G-XXXXXXXXXX. Deixe vazio até existir.
PUBLIC_GA_MEASUREMENT_ID=

# true habilita o Analytics neste ambiente (sempre após a permissão do visitante).
PUBLIC_ANALYTICS_ENABLED=false
